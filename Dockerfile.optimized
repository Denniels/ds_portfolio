# Dockerfile para Data Science Portfolio
# Optimizado para capa gratuita de Google Cloud Run

# Fase de construcción - Usamos una imagen base ligera
FROM python:3.9-slim AS build

WORKDIR /app

# Copiamos solo los archivos necesarios primero para aprovechar la caché de Docker
COPY requirements.txt .

# Instalamos dependencias eficientemente
RUN pip install --no-cache-dir -r requirements.txt

# Copiamos el resto de los archivos
COPY app/ ./app/
COPY data/ ./data/

# Variables de entorno para optimización
ENV PYTHONUNBUFFERED=1
ENV STREAMLIT_SERVER_PORT=8080
ENV STREAMLIT_SERVER_HEADLESS=true
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Configuración de Streamlit para minimizar uso de recursos
ENV STREAMLIT_MEMORY_USE_MMAP=false
ENV STREAMLIT_MEMORY_TRIM_THRESHOLD=0.1
ENV STREAMLIT_MAX_CACHED_SESSIONS=2
ENV STREAMLIT_MAX_CACHED_MESSAGES=10

# Punto de entrada optimizado
ENTRYPOINT ["streamlit", "run", "app/main_simplified.py", "--server.address=0.0.0.0", "--server.port=8080", "--server.enableCORS=false", "--server.enableXsrfProtection=true", "--browser.serverAddress=0.0.0.0", "--browser.gatherUsageStats=false"]
